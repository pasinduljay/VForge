# VForge Local Control-Plane Configuration Template
# Copy to `.env` for local development and replace all CHANGE_ME_* values with
# independent CSPRNG secrets (>= 32 random bytes each).
# NEVER commit `.env` or `.secrets/` or real credentials.
# Production deployments MUST NOT use `.env`; inject secrets via OpenBao / Docker secrets.

# Pinned container image references (verified 2026-11-12)
POSTGRES_IMAGE=postgres:18@sha256:e3d24f6906d0760bf4da0dae872415391ededefad23fd471c47dc53b0ddf3c42
RABBITMQ_IMAGE=rabbitmq:4-management@sha256:7ddb7fd4630026bc84f72760f33629e8c1ef3bb106360fb385fae0dd4ef886f3
VALKEY_IMAGE=valkey/valkey:9-alpine@sha256:bf09d58e96d6b4524a15396b65b242bbe18beebbcc15a04d8ee75ddac62fae0b
OPA_IMAGE=openpolicyagent/opa:1.22.3@sha256:c1632ced2b6726a257a075523ce4d86258b721b5512e05ee3344ae26148e9031
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4.0@sha256:5f3fb534cde6bf006d79f5912473e5d2c828c707cdfc52e16972803aca9d43dd

# Runtime environment & centralized secret provider
VFORGE_ENV=development
LOG_LEVEL=INFO
SECRET_PROVIDER=local_dev

# PostgreSQL (separated bootstrap admin, migration owner, and runtime app role)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vforge
POSTGRES_PASSWORD=CHANGE_ME_BOOTSTRAP_POSTGRES_ADMIN_PASSWORD
POSTGRES_MIGRATOR_USER=vforge_migrator
POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME_POSTGRES_MIGRATOR_PASSWORD
POSTGRES_APP_USER=vforge_app
POSTGRES_APP_PASSWORD=CHANGE_ME_POSTGRES_APP_PASSWORD

# RabbitMQ (separated management admin and restricted vhost runtime user)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=vforge
RABBITMQ_ADMIN_USER=vforge_admin
RABBITMQ_ADMIN_PASSWORD=CHANGE_ME_RABBITMQ_ADMIN_PASSWORD
RABBITMQ_APP_USER=vforge_app
RABBITMQ_APP_PASSWORD=CHANGE_ME_RABBITMQ_APP_PASSWORD

# Valkey 9.1.3 ACL users (hashes live in ignored `.secrets/valkey/users.acl`)
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_DB=0
VALKEY_ADMIN_PASSWORD=CHANGE_ME_VALKEY_ADMIN_PASSWORD
VALKEY_HEALTH_PASSWORD=CHANGE_ME_VALKEY_HEALTH_PASSWORD
VALKEY_APP_USER=vforge_app
VALKEY_APP_PASSWORD=CHANGE_ME_VALKEY_APP_PASSWORD

# Phase 1+ OIDC (opt-in local `--profile dev-oidc` Keycloak)
OIDC_ENABLED=false
OIDC_ISSUER=http://127.0.0.1:8080/realms/vforge
OIDC_INTERNAL_BASE_URL=http://keycloak:8080/realms/vforge
OIDC_CLIENT_ID=vforge-api
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:3000/api/v1/auth/oidc/callback
KEYCLOAK_ADMIN_USER=vforge-dev-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_DEV_ADMIN_PASSWORD

# Phase 2 Scope Signing (dev uses ephemeral Ed25519 when path omitted; prod requires mounted path)
SCOPE_SIGNING_KEY_ID=vf-scope-dev-1
SCOPE_SIGNING_PRIVATE_KEY_PATH=

# OpenBao readiness (Phase 14 full deployment; short-lived workload auth only, never root tokens)
OPENBAO_ADDR=
OPENBAO_NAMESPACE=
OPENBAO_AUTH_METHOD=approle
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID_FILE=
